# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENROUTER_API_KEY: Optional API key for OpenRouter models (Qwen, Llama, etc.)
OPENROUTER_API_KEY="MY_OPENROUTER_KEY"

# AI Models Configuration (Server-side proxy)
AI_CLASSIFIER_MODEL="qwen/qwen-2.5-72b-instruct"
AI_REASONER_MODEL="qwen/qwen-2.5-72b-instruct"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
